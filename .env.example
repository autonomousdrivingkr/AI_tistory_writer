# === LLM API 키 ===
# config.json 의 llm.provider 가 가리키는 키만 있으면 됩니다.

# (무료) Google Gemini API 키 — https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=여기에_Gemini_키_입력

# (유료) Anthropic(Claude) API 키 — https://console.anthropic.com 에서 발급
# 유료 전환 시 config.json 의 provider 를 "claude" 로 바꾸고 아래 키를 채우세요.
ANTHROPIC_API_KEY=sk-ant-여기에_키_입력

# === 카카오 로그인 자동 입력 (선택) ===
# "npm run login" 시 카카오 로그인 폼의 아이디/비밀번호를 자동으로 채웁니다.
# 비워두면 기존처럼 브라우저에서 직접 로그인하면 됩니다.
# ⚠️ 카카오가 캡차/2단계 인증을 띄우면 그 단계는 사람이 직접 처리해야 합니다.
KAKAO_EMAIL=카카오_아이디(이메일)
KAKAO_PASSWORD=카카오_비밀번호

# === 본문 사진 (선택) ===
# (무료) Pexels API 키 — https://www.pexels.com/api/ 에서 발급
# config.json 의 images.enabled=true 일 때 본문에 관련 사진을 자동 삽입합니다.
# 키가 없으면 사진 없이 글만 발행됩니다(에러 아님).
PEXELS_API_KEY=여기에_Pexels_키_입력

# === 사실 조사 / 웹 검색 (선택, 환각 감소) ===
# config.json 의 research.enabled=true 일 때 글 생성 전에 웹 검색으로 사실 자료를 모읍니다.
#
# ① Gemini 그라운딩: 별도 키 불필요 — 위의 GEMINI_API_KEY 를 그대로 씁니다.
# ② (무료) 네이버 검색 API — https://developers.naver.com/ 에서 애플리케이션 등록 후 발급.
#    맛집·카페·여행 등 "지역·실존 업체" 주제에서 정확도가 높습니다(실존 상호명·주소).
#    두 키가 모두 없으면 네이버 검색은 건너뛰고 Gemini 만 사용합니다(에러 아님).
NAVER_CLIENT_ID=여기에_네이버_Client_ID_입력
NAVER_CLIENT_SECRET=여기에_네이버_Client_Secret_입력

# (GitHub Actions 전용) 저장된 로그인 세션을 base64로 인코딩한 값
# 로컬에서는 비워두세요. scripts/export-session.js 로 생성합니다.
# TISTORY_STORAGE_STATE=
