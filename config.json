{
  "llm": {
    "provider": "gemini",
    "maxTokens": 12000,
    "temperature": 1,
    "models": {
      "gemini": "gemini-2.5-flash-lite",
      "claude": "claude-sonnet-4-6"
    }
  },
  "research": {
    "enabled": true,
    "strategy": "auto",
    "maxSources": 5,
    "stopWhenEnough": true,
    "attachSources": true,
    "models": {
      "gemini": "gemini-2.5-flash"
    },
    "localKeywords": [
      "맛집", "카페", "근처", "주변", "골프", "CC", "컨트리클럽", "여행", "숙소",
      "호텔", "펜션", "리조트", "가볼만한", "데이트", "코스", "명소", "축제", "시장"
    ]
  },
  "tistory": {
    "publish": true,
    "publishVisibility": "public",
    "defaultBlog": "captainzone",
    "blogs": [
      {
        "id": "captainzone",
        "label": "메인 블로그",
        "blogName": "captainzone",
        "topicsFile": "topics.captainzone.json",
        "defaultCategory": ""
      },
      {
        "id": "marvel-ironman",
        "label": "마블 아이언맨",
        "blogName": "marvel-ironman",
        "topicsFile": "topics.marvel-ironman.json",
        "defaultCategory": ""
      }
    ]
  },
  "tibedra": {
    "enabled": true,
    "topicsFile": "topics.tibedra.json",
    "defaultCategory": "투자",
    "author": "Derek Ji"
  },
  "images": {
    "enabled": true,
    "provider": "pexels",
    "perArticle": 3,
    "orientation": "landscape"
  },
  "schedule": {
    "slots": {
      "morning": {
        "startHour": 4,
        "endHour": 12
      },
      "evening": {
        "startHour": 18,
        "endHour": 24
      }
    }
  },
  "selectors": {
    "titleInput": "#post-title-inp",
    "tagInput": "#tagText",
    "modeButton": "#editor-mode-layer-btn-open",
    "modeHtml": "#editor-mode-html",
    "modeVisualItem": "#editor-mode-kakao-tistory:visible",
    "codeMirror": ".CodeMirror",
    "imageFileInput": "input[type=\"file\"]",
    "imageButton": "[id*=\"image\"], [aria-label*=\"사진\"], [class*=\"btn-image\"]",
    "attachButton": "[aria-label=\"첨부\"]:visible",
    "attachImageItem": "#attach-image:visible",
    "draftCancelText": "취소",
    "publishOpenText": "완료",
    "publishConfirmText": "공개 발행"
  },
  "gitSync": true,
  "storageStatePath": "storage_state.json"
}